# Copy to .env.local for local development.
# For Vercel production: use values from .env.vercel (gitignored) or paste
# the same keys in Vercel → Settings → Environment Variables.
# See docs/03-SYSTEM-DESIGN.md

# Neon
DATABASE_URL=
DATABASE_URL_DIRECT=

# Auth.js
AUTH_SECRET=
# Optional alias used in older notes
SESSION_SECRET=

# Local: http://localhost:3000 — Production: https://egigogonewspaper.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brevo (transactional + newsletter email)
BREVO_API_KEY=
# Verified sender, e.g. "Egigogo Newspaper <hello@egigogonewspaper.com>"
EMAIL_FROM=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_ENDPOINT=

# Web Push (generate with: npx web-push generate-vapid-keys)
# Public key must match NEXT_PUBLIC_VAPID_PUBLIC_KEY
VAPID_SUBJECT=mailto:hello@egigogonewspaper.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# First admin (seed) — optional on Vercel after first seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# External cron → /api/cron/publish and /api/cron/backup
CRON_SECRET=
