# Copy to .env.local for local / Vercel env for production.
# See docs/03-SYSTEM-DESIGN.md

# Neon
DATABASE_URL=

# Auth.js
AUTH_SECRET=
# Optional alias used in older notes
SESSION_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brevo (transactional + newsletter email)
BREVO_API_KEY=
# Verified sender, e.g. news@egigogo.ng or "Egigogo Newspaper <news@egigogo.ng>"
EMAIL_FROM=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_ENDPOINT=

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_SUBJECT=mailto:news@egigogo.ng
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# First admin (seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# External cron → /api/cron/*
CRON_SECRET=
